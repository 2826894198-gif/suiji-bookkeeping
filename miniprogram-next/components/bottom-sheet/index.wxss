.sheet-mask { position:fixed;inset:0;z-index:200;display:flex;align-items:flex-end; }
.sheet-backdrop { position:absolute;inset:0;background:rgba(27,33,22,.32); }
.sheet-body { position:relative;background:#f8faf5;border:1px solid white;border-radius:30px 30px 0 0;box-shadow:0 -6px 28px rgba(30,38,22,.08);width:100%;max-width:760px;max-height:88vh;margin:0 auto;padding:12px 22px 30px; }
.sheet-head { display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:6px; }
.sheet-title { font-size:20px;font-weight:550;min-width:0;overflow-wrap:anywhere; }
.sheet-scroll { width:100%;overscroll-behavior:contain; }
.sheet-content { display:flow-root; }
.sheet-with-footer { display:flex;flex-direction:column; }
.sheet-with-footer .sheet-scroll { flex-shrink:1;min-height:0; }
.sheet-footer { flex-shrink:0;padding-top:10px;border-top:1px solid #e0e5d8; }

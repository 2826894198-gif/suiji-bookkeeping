@import "../../styles/sage-glass.wxss";
.budget-period { display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:13px;color:#637057;margin:14px 0 12px; }.budget-period .pill { background:rgba(255,255,255,.74);border-color:white;box-shadow:0 3px 8px rgba(49,61,35,.04); }
.budget-panel { padding:14px 20px 16px; }.budget-label { font-size:14px;color:#606b55; }
.budget-main { display:grid;grid-template-columns:minmax(0,1fr) 92px;align-items:center;gap:16px;margin:5px 0 18px; }
.budget-amount { font-size:46px;white-space:nowrap; }.budget-amount .currency { font-size:25px;margin-right:3px; }.budget-amount.over-budget { color:#a4483c; }
.budget-ring { position:relative;width:92px;height:92px; }.budget-ring image { position:absolute;top:0;left:0;width:100%;height:100%; }.ring-label { position:absolute;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:11px;color:#5c6b4d; }.ring-percent { font-family:"Helvetica Neue",Arial,sans-serif;font-size:18px;font-weight:400;color:#405126; }
.budget-footer { display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin:0 -12px -8px;padding:13px 14px;font-size:12px;color:#5d6a50; }.footer-value { font-weight:400;color:#2e3822; }
.wide-budget .budget-main { grid-template-columns:minmax(0,1fr); }.wide-budget .budget-amount { font-size:32px;white-space:normal;overflow-wrap:anywhere; }.wide-budget .budget-ring { justify-self:end; }
.cycle-strip { display:flex;align-items:center;gap:12px;padding:16px 4px;border-bottom:1px solid #e1e5df;margin-top:8px; }.cycle-strip > view:nth-child(2) { display:flex;flex-direction:column;gap:3px;flex:1; }.cycle-title { font-size:14px; }.cycle-strip .icon-circle { background:#e9edde;box-shadow:inset 0 1px 1px white; }
.budget-categories { display:flex;flex-direction:column;gap:0; }.category-budget { padding:16px 0;border:0;border-bottom:1px solid #e1e5df;background:transparent;border-radius:0; }.category-budget .icon-circle { width:34px;height:34px;border-radius:12px;background:#e9edde;box-shadow:inset 0 1px 1px rgba(255,255,255,.8); }
.budget-used { font-family:"Helvetica Neue",Arial,sans-serif;font-size:17px;font-weight:400;font-variant-numeric:tabular-nums;white-space:nowrap;flex-shrink:0; }.budget-used > text { font-size:12px;color:#637057; }.category-budget .between > .row { flex:1;min-width:0; }.category-budget .row > text { overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:14px; }
.category-track { margin:12px 0 8px;height:6px;background:#e0e5d9; }.progress-value.over { background:#b67c6e; }.category-caption { font-size:11px;color:#637057; }.category-budget.surface-rose { background:#f6ece8;padding:16px 12px;border-radius:16px;margin-top:8px;border-bottom:0; }
.limit-grid { display:grid;grid-template-columns:1fr 1fr;gap:0 12px; }.limit-grid .field { margin:8px 0; }.total-input { font-size:23px;height:56px; }
@media(max-width:350px) { .budget-panel { padding:12px 16px 14px; }.budget-main { grid-template-columns:minmax(0,1fr) 78px;gap:10px; }.budget-ring { width:78px;height:78px; }.budget-amount { font-size:39px; }.ring-percent { font-size:16px; }.budget-footer { font-size:11px;margin-left:-9px;margin-right:-9px; } }
@media(min-width:600px) { .budget-categories { display:grid;grid-template-columns:1fr 1fr;gap:0 24px; }.budget-panel { padding:20px 24px; }.budget-amount { font-size:54px; }.budget-footer { padding:16px; } }

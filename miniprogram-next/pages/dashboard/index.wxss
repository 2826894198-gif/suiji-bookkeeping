.expense-summary { margin-top:12px;margin-bottom:14px; }
.expense-label { font-size:14px;color:#858893; }
.period-pill { font-size:12px;min-height:31px;padding:5px 11px;border-color:#e2e4e4; }
.expense-value { font-family:"Helvetica Neue",Arial,sans-serif;font-size:43px;letter-spacing:-1.7px;line-height:1.15;font-weight:400;margin:-7px 0 10px;font-variant-numeric:tabular-nums; }
.expense-value .currency { font-size:29px;letter-spacing:-1px;margin-right:3px; }
.progress-wrap { position:relative; }
.progress-marker { position:absolute;top:-15px; }
.finance-pair { display:flex;gap:6px;margin:0 -3px 11px; }
.finance-card { display:block;flex:1;min-width:0;min-height:176px;border-radius:26px;padding:14px 14px 12px;text-align:left;box-shadow:inset 0 1px 1px rgba(255,255,255,.4); }
.finance-top { display:flex;align-items:center;gap:8px;white-space:nowrap;font-size:12px; }
.finance-top .icon-ring { height:38px;width:38px; }
.finance-top .dark-circle { width:34px;height:34px;margin-left:auto;flex-shrink:0; }
.finance-top > text { font-size:11px; }
.card-amount { font-family:"Helvetica Neue",Arial,sans-serif;font-size:28px;line-height:1.2;letter-spacing:-.9px;white-space:nowrap;margin-top:23px;font-weight:400;font-variant-numeric:tabular-nums; }
.card-amount > text { font-size:20px;margin-right:3px; }
.card-footer { display:flex;justify-content:space-between;gap:5px;font-size:11px;margin-top:42px;white-space:nowrap; }
.daily-panel { padding:12px 14px;border-radius:26px;margin:0 -3px; }
.daily-panel .icon-ring { width:34px;height:34px; }
.chart-title { font-size:14px; }
.pill-filter { background:#f3f5f1;border:0;min-height:31px; }
.daily-selection { display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:8px; }
.daily-date { display:flex;align-items:center;gap:6px;min-height:44px;max-width:50%;flex-shrink:0;font-size:13px;color:#455137; }
.daily-date text { min-width:0;white-space:nowrap; }
.daily-amount { min-width:0;display:flex;flex-direction:column;align-items:flex-end;gap:2px; }
.daily-amount-label { font-size:10px;color:#62714f; }
.daily-amount .money { font-size:clamp(19px,5.5vw,25px);line-height:1.25;overflow-wrap:anywhere;text-align:right; }
.daily-panel .chart-box { height:176px;margin-top:4px; }
.daily-caption { display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 12px;font-size:10px;line-height:1.6;color:#62714f;margin-top:4px; }
.today-head { margin-top:18px;margin-bottom:0;min-height:44px;gap:8px; }
.today-head .section-title { font-size:17px;font-weight:500; }
.today-head .text-link { min-height:44px;flex-shrink:0; }
.day-count { font-size:11px;font-weight:400;color:#626f54;margin-left:8px;white-space:nowrap; }
.calendar-range { font-size:13px;color:#59644c;margin-bottom:20px; }
.calendar-grid { display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px; }
.calendar-weekdays { font-size:12px;color:#647157;text-align:center;margin-bottom:8px; }
.calendar-day { display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-width:0;min-height:48px;border-radius:12px;color:#27331c;font-size:13px; }
.calendar-day.selected { background:#26321c;color:#fff; }
.calendar-dot { width:4px;height:4px;border-radius:50%;background:transparent; }
.calendar-dot.has-expense { background:#7a8e4b; }
.calendar-day.selected .calendar-dot.has-expense { background:#ddff58; }
.calendar-note { font-size:12px;line-height:1.6;color:#59644c;margin-top:18px; }
@media(max-width:350px) { .finance-card { padding:12px 10px;min-height:164px; }.finance-top { gap:5px; }.finance-top .icon-ring { width:30px;height:30px; }.finance-top .dark-circle { width:29px;height:29px; }.card-amount { font-size:24px; }.card-footer { font-size:10px; }.expense-value { font-size:39px; } }
@media(min-width:600px) {
  .home-grid { display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:stretch; }
  .finance-pair { flex-direction:column;gap:12px;margin:0; }
  .finance-card { min-height:0;padding:14px 18px;display:flex;flex-direction:column;border-radius:24px; }
  .finance-top .icon-ring { width:30px;height:30px; }
  .finance-top .dark-circle { width:29px;height:29px; }
  .finance-top > text { font-size:12px; }
  .card-amount { font-size:28px;margin-top:10px; }
  .card-footer { margin-top:auto;padding-top:10px; }
  .daily-panel .chart-box { height:176px; }
  .expense-value { font-size:52px; }
}

@import "../../styles/sage-glass.wxss";
.entry-type { margin:15px 0 14px;background:#e8ecdf; }.entry-type .segment { font-weight:400; }.entry-type .segment.active { font-weight:400;box-shadow:0 3px 9px rgba(54,64,43,.07); }
.amount-panel { padding:16px 20px;min-height:174px; }.amount-label { font-size:14px;color:#606b55; }
.amount-field { display:flex;align-items:baseline;gap:7px;margin:13px 0 14px; }.amount-field > text { font-size:27px;font-weight:300;color:#333c29; }.amount-field input { font-family:"Helvetica Neue",Arial,sans-serif;min-width:0;flex:1;height:66px;font-size:54px;line-height:1.16;color:#252c22;letter-spacing:-1.35px;font-weight:300; }.amount-field.long-amount input { font-size:34px; }.amount-placeholder { color:#68725b; }
.amount-help { display:flex;align-items:flex-start;gap:6px;border-top:1px solid rgba(95,108,72,.16);padding-top:10px;font-size:12px;color:#5c694e; }.amount-help > text { min-width:0;overflow-wrap:anywhere; }
.category-panel { padding:11px 16px 16px;margin:18px 0; }.form-title { font-size:15px;font-weight:400; }
.category-grid { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px 8px;margin:12px 0 16px; }.category-choice { display:flex;flex-direction:column;align-items:center;gap:6px;min-height:62px;font-size:12px;color:#637057; }.category-choice > text { overflow-wrap:anywhere; }
.category-icon { display:flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:15px;background:#edf0e7;box-shadow:inset 0 1px 1px rgba(255,255,255,.8); }.category-choice.active { color:#435333;font-weight:400; }.category-choice.active .category-icon { background:#7a8e5f;box-shadow:inset 0 1px 1px rgba(255,255,255,.4),0 3px 8px rgba(64,81,43,.12); }
.subcategories { display:flex;gap:6px;flex-wrap:wrap;border-top:1px solid #e1e6dc;padding-top:12px; }.subcategories .pill { min-height:44px;min-width:44px;padding:7px 11px;border:0;border-radius:15px;background:#f0f3e9;color:#5f6c51;font-size:12px;white-space:normal;overflow-wrap:anywhere; }.subcategories .pill-ink { background:#dfe7cf;color:#3d502e; }
.legacy-child { font-size:11px;line-height:1.7;color:#637156;margin-top:10px; }
.entry-fields { padding:0 16px; }.entry-fields > .field { display:flex;align-items:center;gap:10px;min-height:56px;margin:0;border-bottom:1px solid #e1e6dc; }.entry-fields .field-label { margin:0;font-size:13px;white-space:nowrap;color:#637057; }
.entry-fields > .field > picker { flex:1;min-width:0; }.entry-fields .field-picker { border:0;border-radius:0;background:transparent;padding:8px 0 8px 6px;min-height:54px;font-size:13px;justify-content:flex-end; }.entry-fields .field-picker .row { justify-content:flex-end;gap:6px; }.entry-fields .field-picker .row > ui-icon { display:none; }
.entry-moment { display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:56px;border-bottom:1px solid #e1e6dc; }.moment-pickers { display:flex;align-items:center;justify-content:flex-end;gap:10px;min-width:0; }.moment-pickers > picker { min-width:0; }.moment-pickers > picker + picker { border-left:1px solid #dce2d6;padding-left:10px; }.moment-value { display:flex;align-items:center;justify-content:flex-end;gap:6px;min-height:54px;font-size:13px;white-space:nowrap; }
.note-toggle { display:flex;align-items:center;gap:8px;width:100%;min-height:56px;font-size:13px;color:#637057; }.note-toggle ui-icon:last-child { margin-left:auto; }.entry-fields textarea { background:#f1f3ee;margin-bottom:16px; }
.save-entry { margin-top:18px; }.input-methods { display:flex;justify-content:space-between;gap:5px;margin-top:13px; }.input-methods button { min-height:45px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;flex:1;font-size:12px;color:#637156; }.input-methods text { font-size:10px;color:#68745c; }
@media(max-width:350px) { .amount-panel { padding:16px; }.amount-field input { font-size:50px; }.category-panel { padding:11px 12px 16px; }.entry-fields { padding:0 12px; }.entry-fields .field-label { font-size:12px; }.entry-fields .field-picker { font-size:12px; }.moment-pickers { gap:7px; }.moment-pickers > picker + picker { padding-left:7px; }.moment-value { font-size:11px;gap:4px; } }
@media(min-width:600px) { .category-grid { grid-template-columns:repeat(6,minmax(0,1fr)); }.amount-panel { padding:24px; }.entry-fields { margin-top:16px; } }

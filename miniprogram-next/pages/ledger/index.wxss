@import "../../styles/sage-glass.wxss";
.ledger-summary { padding:14px 20px 16px;margin:14px 0 20px; }
.summary-head { display:flex;align-items:center;justify-content:space-between;gap:8px; }.summary-heading { display:flex;align-items:center;gap:3px;min-width:0;font-size:13px;color:#606b55; }.summary-heading > text { white-space:nowrap; }.summary-stat { width:32px;min-height:44px;display:flex;align-items:center;justify-content:center;flex-shrink:0; }
.sage-page .period-neutral { min-height:44px;padding:6px 11px;font-size:11px;color:#4f5d43;border-color:rgba(255,255,255,.82);background:rgba(250,252,245,.66);box-shadow:0 3px 8px rgba(55,68,40,.065);flex-shrink:0; }
.summary-main { display:flex;align-items:baseline;gap:5px;margin:5px 0 20px;font-size:48px; }.summary-main .currency { font-size:26px;flex-shrink:0; }.summary-main > text:last-child { min-width:0;overflow-wrap:anywhere; }.summary-main.long-figure { font-size:32px; }
.summary-footer { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin:0 -12px -8px;padding:12px 7px; }.summary-cell { display:flex;flex-direction:column;gap:6px;min-width:0;padding:0 9px; }.summary-cell + .summary-cell { border-left:1px solid rgba(101,115,84,.2); }.summary-cell .label { color:#606d53;font-size:11px; }.summary-cell .value { font-family:"Helvetica Neue",Arial,sans-serif;font-size:16px;font-weight:400;letter-spacing:-.3px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere; }
.filter-row { margin:8px 0 16px;gap:8px; }.type-tabs { display:flex;gap:4px; }.type-tabs button { display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:8px 10px;border-radius:22px;color:#66715c;font-size:13px; }.type-tabs .chosen { background:#87976d;color:white;box-shadow:inset 0 1px 1px rgba(255,255,255,.5),0 3px 7px rgba(76,91,52,.12);font-weight:400; }
.date-filter { display:flex;align-items:center;gap:8px;min-height:44px;width:100%;padding:8px 14px;margin:0 0 12px;border-radius:16px;background:#e6eddb;color:#425131;font-size:13px; }.date-filter-clear { margin-left:auto;font-size:12px; }
.ledger-group { padding:14px 16px 3px;margin:12px 0; }.group-head { display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:13px;color:#626c58;padding:2px 0 4px; }.group-head > text:first-child { min-width:0; }.group-head > text:last-child { flex-shrink:0; }.filtered-label { font-size:11px;font-weight:400;color:#687064; }
.day-totals { display:flex;flex-wrap:wrap;gap:8px 20px;padding:9px 0 13px;border-bottom:1px solid #e1e6dc;font-size:12px;color:#637057; }.day-totals > view { display:flex;align-items:baseline;gap:5px; }.day-money { font-family:"Helvetica Neue",Arial,sans-serif;font-size:16px;color:#252e1f;font-weight:400;white-space:nowrap; }.day-income { color:#536747; }.refund-caption { font-size:11px;color:#637156;padding-top:8px; }
.list-end { text-align:center;font-size:11px;color:#68745c;padding:18px 0; }
@media(max-width:350px) { .ledger-summary { padding:12px 16px 14px; }.summary-heading { font-size:12px; }.summary-stat { width:26px; }.sage-page .period-neutral { padding:6px 9px;font-size:10px; }.summary-main { font-size:44px; }.summary-main.long-figure { font-size:29px; }.summary-footer { margin-left:-9px;margin-right:-9px;padding-left:4px;padding-right:4px; }.summary-cell { padding:0 7px; }.summary-cell .label { font-size:10px; }.summary-cell .value { font-size:14px; }.type-tabs button { padding-left:8px;padding-right:8px; }.day-totals { gap:8px 14px; } }
@media(min-width:600px) { .ledger-summary { padding:20px 26px;margin-top:16px; }.summary-main { font-size:56px;margin:8px 0 24px; }.summary-main.long-figure { font-size:42px; }.summary-footer { margin-left:-14px;margin-right:-14px;padding:16px 12px; }.summary-cell { padding:0 16px; }.summary-cell .label { font-size:12px; }.summary-cell .value { font-size:20px; }.ledger-group { padding:18px 22px 5px; } }

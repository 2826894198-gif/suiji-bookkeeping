{
  "appid": "touristappid",
  "projectname": "随记",
  "description": "随记 · 个人记账与预算管理",
  "compileType": "miniprogram",
  "miniprogramRoot": "./",
  "cloudfunctionRoot": "cloudfunctions/",
  "libVersion": "3.15.2",
  "setting": {
    "es6": true,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "urlCheck": true,
    "enhance": false
  },
  "packOptions": {
    "ignore": [
      {
        "type": "file",
        "value": "assets/glass-dock.png"
      },
      {
        "type": "folder",
        "value": "cloudfunctions"
      },
      {
        "type": "folder",
        "value": "scripts"
      },
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "folder",
        "value": "docs"
      },
      {
        "type": "suffix",
        "value": ".md"
      },
      {
        "type": "suffix",
        "value": ".prompt.txt"
      }
    ]
  }
}

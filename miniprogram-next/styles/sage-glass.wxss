.sage-page { color:#252c22;font-weight:400; }
.sg-panel { position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.94);border-radius:28px;background:#e5eadc;box-shadow:inset 0 1px 1px rgba(255,255,255,.86),inset 0 -1px 2px rgba(99,113,75,.08),0 8px 20px rgba(50,62,36,.065); }
.sg-texture { position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none; }
.sg-panel > view { position:relative;z-index:1; }
.sg-figure { min-width:0;font-family:"Helvetica Neue",Arial,sans-serif;font-weight:300;line-height:1.16;letter-spacing:-.025em;font-variant-numeric:tabular-nums; }
.sg-inset { border:1px solid rgba(255,255,255,.72);border-radius:20px;background:rgba(251,252,247,.58);box-shadow:inset 0 1px 1px rgba(255,255,255,.72); }
.sg-surface { border:1px solid rgba(255,255,255,.94);border-radius:26px;background:rgba(255,255,255,.74);box-shadow:inset 0 1px 1px rgba(255,255,255,.7),0 5px 14px rgba(46,53,39,.035); }
.sage-page .search-box { min-height:46px;margin:18px 0 10px;border-radius:25px;background:rgba(255,255,255,.72);box-shadow:0 3px 10px rgba(46,53,39,.035); }
.sage-page .search-box input { font-size:13px; }
.sage-page .section-head .section-title { font-size:17px;font-weight:400; }
.sage-page .primary { background:#2e3b25;font-weight:400; }
.sage-page .primary[disabled] { background:#2e3b25; }
.sage-page .notice { background:rgba(232,237,221,.62);color:#59664a; }
.sage-page .text-link { color:#626d58; }
.sage-page .hint { color:#66715c; }
.sage-page .pill { min-height:44px;font-size:12px; }
.sage-page .tap-icon { flex-shrink:0; }
